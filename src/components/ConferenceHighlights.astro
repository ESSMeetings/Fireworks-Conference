---
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
const isZh = lang === "zh";
const titleClass = isZh ? "font-zh-display font-bold" : "font-display";
const kickerClass = isZh ? "font-zh-sans font-bold" : "font-semibold";
---

<section id="gallery" class="mx-auto max-w-6xl px-5 py-16 sm:py-[4.5rem]">
  <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-fuchsia);">
    {c.galleryKicker}
  </p>
  <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class:list={["text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.galleryTitle}</h2>
      <p class="mt-3 max-w-3xl" style="color: var(--muted);">{c.galleryIntro}</p>
    </div>
    <a href={c.galleryAlbumHref} target="_blank" rel="noopener noreferrer" class="shrink-0 text-sm font-semibold underline-offset-4 hover:underline" style="color: var(--accent-cyan);">
      {c.galleryAlbumLabel}<span class="ml-1" aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="mt-8 space-y-4">
    {c.gallerySections.map((group, groupIndex) => (
      <details class="highlight-group overflow-hidden rounded-[1.75rem] border" style="border-color: var(--line); background: var(--card);" open={groupIndex === 0}>
        <summary class="group-summary flex cursor-pointer list-none items-center gap-4 px-5 py-5 sm:px-7 sm:py-6">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full text-xs font-bold" style="background: var(--program-wash); color: var(--accent-gold);">
            {String(groupIndex + 1).padStart(2, "0")}
          </span>
          <span class="min-w-0 flex-1">
            <span class:list={["block text-xl sm:text-2xl", titleClass]} style="color: var(--ink);">{group.title}</span>
            <span class="mt-1 block text-sm sm:text-base" style="color: var(--muted);">{group.subtitle}</span>
          </span>
          <span class="summary-icon text-2xl" style="color: var(--accent-cyan);" aria-hidden="true">＋</span>
        </summary>
        <div class="border-t px-4 pb-6 pt-5 sm:px-6" style="border-color: var(--line);">
          <div class="photo-strip flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3">
            {group.photos.map((photo, photoIndex) => (
              <figure class="min-w-[86%] snap-start overflow-hidden rounded-2xl sm:min-w-[48%] lg:min-w-[32%]" style="background: var(--program-wash);">
                <img src={photo.src} alt={photo.caption} class="aspect-[4/3] w-full object-cover" loading={groupIndex === 0 && photoIndex === 0 ? "eager" : "lazy"} />
                <figcaption class="min-h-24 px-4 py-4 text-sm leading-relaxed" style="color: var(--ink);">
                  {photo.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </details>
    ))}
  </div>
</section>

<section id="media" class="mx-auto max-w-6xl px-5 py-16 sm:py-[4.5rem]">
  <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-cyan);">{c.mediaKicker}</p>
  <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.mediaTitle}</h2>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {c.mediaReports.map((report) => (
      <article class="card-hover flex min-h-64 flex-col rounded-3xl p-6" style="background: var(--card);">
        <p class="text-xs font-semibold uppercase tracking-[0.18em]" style="color: var(--accent-gold);">{report.source}</p>
        <h3 class:list={["mt-5 text-xl leading-snug", titleClass]} style="color: var(--ink);">{report.title}</h3>
        <a href={report.href} target="_blank" rel="noopener noreferrer" class="mt-auto pt-8 text-sm font-semibold underline-offset-4 hover:underline" style="color: var(--accent-cyan);">
          {c.mediaReadLabel}<span class="ml-1" aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .group-summary::-webkit-details-marker { display: none; }
  .highlight-group[open] .summary-icon { transform: rotate(45deg); }
  .summary-icon { transition: transform 220ms ease; }
  .photo-strip { scrollbar-width: thin; scrollbar-color: var(--line-strong) transparent; }
  .photo-strip::-webkit-scrollbar { height: 0.45rem; }
  .photo-strip::-webkit-scrollbar-thumb { border-radius: 9999px; background: var(--line-strong); }
  @media (prefers-reduced-motion: reduce) { .summary-icon { transition: none; } }
</style>
