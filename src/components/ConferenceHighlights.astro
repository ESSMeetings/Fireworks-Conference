---
import type { Lang } from "../i18n/copy";
import { t } from "../i18n/copy";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = t(lang);
const isZh = lang === "zh";
const titleClass = isZh ? "font-zh-display font-bold" : "font-display";
const kickerClass = isZh ? "font-zh-sans font-bold" : "font-semibold";
---

<section id="gallery" class="mx-auto max-w-6xl px-5 py-16 sm:py-[4.5rem]">
  <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-fuchsia);">
    {c.galleryKicker}
  </p>
  <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class:list={["text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.galleryTitle}</h2>
      <p class="mt-3 max-w-3xl" style="color: var(--muted);">{c.galleryIntro}</p>
    </div>
    <a href={c.galleryAlbumHref} target="_blank" rel="noopener noreferrer" class="shrink-0 text-sm font-semibold underline-offset-4 hover:underline" style="color: var(--accent-cyan);">
      {c.galleryAlbumLabel}<span class="ml-1" aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="mt-8 space-y-4">
    {c.gallerySections.map((group, groupIndex) => (
      <details class="highlight-group overflow-hidden rounded-[1.75rem] border" style="border-color: var(--line); background: var(--card);" open>
        <summary class="group-summary flex cursor-pointer list-none items-center gap-4 px-5 py-5 sm:px-7 sm:py-6">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full text-xs font-bold" style="background: var(--program-wash); color: var(--accent-gold);">
            {String(groupIndex + 1).padStart(2, "0")}
          </span>
          <span class="min-w-0 flex-1">
            <span class:list={["block text-xl sm:text-2xl", titleClass]} style="color: var(--ink);">{group.title}</span>
            <span class="mt-1 block text-sm sm:text-base" style="color: var(--muted);">{group.subtitle}</span>
          </span>
          <span class="summary-icon text-2xl" style="color: var(--accent-cyan);" aria-hidden="true">＋</span>
        </summary>
        <div class="border-t p-4 sm:p-6" style="border-color: var(--line);">
          <div class="story-gallery" data-story-gallery>
            <div class="story-layout">
              <div class="story-left aspect-[3/2] overflow-hidden rounded-2xl">
                {group.photos.map((photo, photoIndex) => (
                  <button type="button" class="story-thumb group relative h-full w-full overflow-hidden rounded-2xl text-left" data-story-thumb-left={photoIndex} hidden={photoIndex !== group.photos.length - 1} aria-label={photo.caption}>
                    <img src={photo.src} alt="" class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]" loading="lazy" />
                    <span class="absolute bottom-3 left-3 grid h-7 min-w-7 place-items-center rounded-full px-2 text-xs font-bold text-white backdrop-blur-md" style="background: rgba(9, 8, 22, 0.64);">{String(photoIndex + 1).padStart(2, "0")}</span>
                  </button>
                ))}
              </div>
              <div class="story-center relative aspect-[3/2] overflow-hidden rounded-2xl">
                {group.photos.map((photo, photoIndex) => (
                  <figure class="story-slide absolute inset-0" data-story-slide hidden={photoIndex !== 0}>
                    <img src={photo.src} alt={photo.caption} class="h-full w-full object-contain" loading={groupIndex === 0 && photoIndex === 0 ? "eager" : "lazy"} />
                    <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-night/95 via-night/70 to-transparent px-5 pb-5 pt-16 text-sm leading-relaxed text-white sm:px-7 sm:pb-7 sm:text-base">
                      {photo.caption}
                    </figcaption>
                  </figure>
                ))}
                <div class="absolute left-4 top-4 rounded-full px-3 py-1 text-xs font-bold text-white backdrop-blur-md" style="background: rgba(9, 8, 22, 0.64);">
                  <span data-story-current>1</span> / {group.photos.length}
                </div>
                <div class="absolute bottom-4 right-4 flex gap-2">
                  <button type="button" class="story-control" data-story-prev aria-label={isZh ? "上一张" : "Previous photo"}>←</button>
                  <button type="button" class="story-control" data-story-next aria-label={isZh ? "下一张" : "Next photo"}>→</button>
                </div>
              </div>
              <div class="story-right aspect-[3/2] overflow-hidden rounded-2xl">
                {group.photos.map((photo, photoIndex) => (
                  <button type="button" class="story-thumb group relative h-full w-full overflow-hidden rounded-2xl text-left" data-story-thumb-right={photoIndex} hidden={photoIndex !== 1} aria-label={photo.caption}>
                    <img src={photo.src} alt="" class="h-full w-full object-contain transition duration-300 group-hover:scale-[1.03]" loading="lazy" />
                    <span class="absolute bottom-3 left-3 grid h-7 min-w-7 place-items-center rounded-full px-2 text-xs font-bold text-white backdrop-blur-md" style="background: rgba(9, 8, 22, 0.64);">{String(photoIndex + 1).padStart(2, "0")}</span>
                  </button>
                ))}
              </div>
            </div>
            <div class="mt-4 flex flex-wrap justify-center gap-2">
            {group.photos.map((photo, photoIndex) => (
                <button type="button" class:list={["story-dot", photoIndex === 0 && "is-active"]} data-story-dot={photoIndex} aria-label={`${photoIndex + 1} / ${group.photos.length}`}></button>
              ))}
            </div>
          </div>
        </div>
      </details>
    ))}
  </div>
</section>

<section id="media" class="mx-auto max-w-6xl px-5 py-16 sm:py-[4.5rem]">
  <p class:list={["text-xs uppercase tracking-[0.32em]", kickerClass]} style="color: var(--accent-cyan);">{c.mediaKicker}</p>
  <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleClass]} style="color: var(--ink);">{c.mediaTitle}</h2>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {c.mediaReports.map((report) => (
      <article class="card-hover flex min-h-64 flex-col rounded-3xl p-6" style="background: var(--card);">
        <p class="text-xs font-semibold uppercase tracking-[0.18em]" style="color: var(--accent-gold);">{report.source}</p>
        <h3 class:list={["mt-5 text-xl leading-snug", titleClass]} style="color: var(--ink);">{report.title}</h3>
        <a href={report.href} target="_blank" rel="noopener noreferrer" class="mt-auto pt-8 text-sm font-semibold underline-offset-4 hover:underline" style="color: var(--accent-cyan);">
          {c.mediaReadLabel}<span class="ml-1" aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .group-summary::-webkit-details-marker { display: none; }
  .highlight-group[open] .summary-icon { transform: rotate(45deg); }
  .summary-icon { transition: transform 220ms ease; }
  .story-slide[hidden], .story-thumb[hidden] { display: none; }
  .story-layout { display: grid; grid-template-columns: 1fr 1fr; grid-template-areas: "center center" "left right"; align-items: center; gap: .75rem; }
  .story-left { grid-area: left; }
  .story-center { grid-area: center; }
  .story-right { grid-area: right; }
  .story-control { display: grid; width: 2.5rem; height: 2.5rem; place-items: center; border: 1px solid rgba(255,255,255,.45); border-radius: 9999px; color: white; background: rgba(9,8,22,.68); backdrop-filter: blur(10px); }
  .story-control:hover { background: rgba(9,8,22,.9); }
  .story-dot { width: .5rem; height: .5rem; border-radius: 9999px; background: var(--line-strong); transition: width 220ms ease, background 220ms ease; }
  .story-dot.is-active { width: 1.5rem; background: var(--accent-fuchsia); }
  @media (min-width: 1024px) {
    .story-layout { grid-template-columns: minmax(9rem,.72fr) minmax(0,2fr) minmax(9rem,.72fr); grid-template-areas: "left center right"; }
  }
  @media (prefers-reduced-motion: reduce) { .summary-icon, .story-dot { transition: none; } }
</style>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll<HTMLElement>("[data-story-gallery]").forEach((gallery) => {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-story-slide]"));
    const leftThumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-story-thumb-left]"));
    const rightThumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-story-thumb-right]"));
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-story-dot]"));
    const counter = gallery.querySelector<HTMLElement>("[data-story-current]");
    if (slides.length === 0) return;
    let current = 0;
    let timer: number | undefined;
    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => { slide.hidden = index !== current; });
      const previous = (current - 1 + slides.length) % slides.length;
      const following = (current + 1) % slides.length;
      leftThumbs.forEach((thumb, index) => { thumb.hidden = index !== previous; });
      rightThumbs.forEach((thumb, index) => { thumb.hidden = index !== following; });
      dots.forEach((dot, index) => dot.classList.toggle("is-active", index === current));
      if (counter) counter.textContent = String(current + 1);
    };
    const stop = () => { if (timer) window.clearInterval(timer); };
    const start = () => { if (!reducedMotion) { stop(); timer = window.setInterval(() => show(current + 1), 5500); } };
    gallery.querySelector("[data-story-prev]")?.addEventListener("click", () => { show(current - 1); start(); });
    gallery.querySelector("[data-story-next]")?.addEventListener("click", () => { show(current + 1); start(); });
    leftThumbs.forEach((thumb, index) => thumb.addEventListener("click", () => { show(index); start(); }));
    rightThumbs.forEach((thumb, index) => thumb.addEventListener("click", () => { show(index); start(); }));
    dots.forEach((dot, index) => dot.addEventListener("click", () => { show(index); start(); }));
    gallery.addEventListener("mouseenter", stop);
    gallery.addEventListener("mouseleave", start);
    gallery.addEventListener("focusin", stop);
    gallery.addEventListener("focusout", start);
    show(0);
    start();
  });
</script>
